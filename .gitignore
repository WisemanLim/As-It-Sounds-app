# =============================================================================
# As It Sounds — Mobile .gitignore
#
# Policy: ignore ONLY real build outputs, machine-specific files, downloaded
# models, and secrets. Everything required to `git clone` → open in Xcode /
# Android Studio → build & run is committed (project files, generated bindings,
# prebuilt xcframeworks, jniLibs, vendored whisper.cpp source + GRDB).
# =============================================================================

# ─── macOS ──────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
.fseventsd

# ─── Editors / IDEs (per-user) ───────────────────────────────────────────────
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
.kotlin/

# Claude Code / oh-my-claudecode session state
.omc/
.claude/

# ─── Logs / scratch ──────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.orig
*.pid

# Keep `.review/` committed (analyst output). Uncomment to ignore:
# .review/

# =============================================================================
# Rust workspace (core/)
# =============================================================================
# Ignore the Cargo build dir, but KEEP the prebuilt xcframeworks that Xcode
# links against (so iOS builds without running build-ios.sh first).
core/target/*
!core/target/AisCoreFFI.xcframework
!core/target/whisper.xcframework
**/*.rs.bk
.cargo/

# Generated UniFFI bindings ARE committed (Swift + Kotlin) so the projects
# compile straight from a clone. (Regenerate with build-ios.sh / build-android.sh.)

# =============================================================================
# whisper.cpp (vendored source under core/third_party/whisper.cpp)
# =============================================================================
# Source is committed so Android's CMake can compile libais_whisper.so on a
# fresh clone. Ignore ONLY whisper's own build output dirs.
core/third_party/whisper.cpp/build/
core/third_party/whisper.cpp/build-*/
core/third_party/**/cmake-build-*/

# =============================================================================
# Android
# =============================================================================
android/build/
android/.gradle/
android/.cxx/
android/app/build/
android/app/.cxx/
android/captures/
android/app/schemas/
android/app/release/
android/.idea/
android/*.iml
android/.kotlin/

# Machine-specific — Android Studio regenerates on first sync.
android/local.properties

# NOTE: gradle-wrapper.jar, jniLibs/*.so, and the UniFFI Kotlin binding
# (com/asitsounds/core/) are now COMMITTED for clone-and-build.

# =============================================================================
# iOS
# =============================================================================
# Xcode derived data + per-user state
ios/.dd/
ios/.dd-real/
ios/.swiftpm/
ios/build/
ios/DerivedData/
ios/**/xcuserdata/
ios/**/*.xcuserdatad/
ios/**/project.xcworkspace/xcuserdata/

# SwiftPM resolved/state
ios/Package.resolved
ios/**/*.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Vendored GRDB source IS committed (paren-path workaround). Ignore only its
# build cache.
ios/packages/**/.build/

# NOTE: ios/AsItSounds.xcodeproj and ios/packages/GRDB are now COMMITTED.

# Archives / IPAs / symbols (build outputs)
*.xcarchive/
*.ipa
*.app.dSYM.zip

# CocoaPods / Carthage (unused, pre-emptive)
Pods/
Podfile.lock
Carthage/Build/

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

# =============================================================================
# Whisper models (downloaded at runtime / test fixtures — never committed)
# =============================================================================
*.bin
ggml-*.mlmodelc/
ggml-*.bin.part

# =============================================================================
# Secrets — must NEVER be committed
# =============================================================================
.env
.env.*
!.env.example
*.p8
*.p12
*.cer
*.mobileprovision
*.keystore
*.jks
android/app/upload-keystore.jks
ios/AsItSounds/GoogleService-Info.plist
android/app/google-services.json
AuthKey_*.p8

# =============================================================================
# Misc
# =============================================================================
.cache/
node_modules/
CMakeUserPresets.json
bom.json
bom.xml
sbom.spdx.json
