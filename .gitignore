# ─── Editors / IDEs ───────────────────────────────────────────────────────
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
.kotlin/

# Claude Code / oh-my-claudecode session state
.omc/
.claude/

# ─── Common build / log artifacts ─────────────────────────────────────────
*.log
*.tmp
*.bak
*.orig
*.pid

# Static analyst output — keep `.review/` committed (delete this line to ignore)
# .review/

# ─── Rust workspace (core/) ───────────────────────────────────────────────
core/target/
core/**/target/
**/*.rs.bk
core/bindings/swift/
core/bindings/kotlin/

# whisper.cpp clone — huge upstream, fetched on demand by
# core/scripts/fetch-whisper.sh (or manual git clone). Keep out of the repo.
core/third_party/

# ─── Rust env / debug ─────────────────────────────────────────────────────
.cargo/

# ─── Android ──────────────────────────────────────────────────────────────
android/build/
android/.gradle/
android/.cxx/
android/app/build/
android/app/.cxx/
android/captures/
android/local.properties
android/.kotlin/

# Generated JNI native libs (re-emitted by core/scripts/build-android.sh)
android/app/src/main/jniLibs/

# UniFFI-generated Kotlin binding (re-emitted by build-android.sh)
android/app/src/main/java/com/asitsounds/core/

# Gradle wrapper jar — leave the .properties + gradlew committed,
# but `gradle/wrapper/gradle-wrapper.jar` is binary; let `gradle wrapper`
# regenerate it on first sync.
android/gradle/wrapper/gradle-wrapper.jar

# Room/SQLDelight schema exports (if Phase 3.5 KMM adds Room back)
android/app/schemas/

# Android Studio per-user
android/.idea/
android/*.iml

# Build outputs
android/app/release/

# ─── iOS ──────────────────────────────────────────────────────────────────
# xcodegen regenerates the project file — never commit it.
ios/AsItSounds.xcodeproj/

# Xcode derived data + per-user state
ios/.dd/
ios/.dd-real/
ios/.swiftpm/
ios/build/
ios/DerivedData/
ios/**/xcuserdata/
ios/**/*.xcuserdatad/
ios/**/project.xcworkspace/xcuserdata/

# Local SwiftPM clone of GRDB (paren-path workaround). Re-clone via:
#   git clone --depth 1 --branch v6.29.3 \
#     https://github.com/groue/GRDB.swift ios/packages/GRDB
ios/packages/

# SwiftPM resolved/state files
ios/Package.resolved
ios/**/*.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Built whisper/AisCore xcframeworks (regenerated by core/scripts/build-ios.sh
# + assemble-whisper-xcframework.sh)
core/target/AisCoreFFI.xcframework/
core/target/whisper.xcframework/
core/target/whisper-ios-device/
core/target/whisper-ios-sim/
core/target/lipo-ios-sim/

# Build intermediate dirs from whisper.cpp's build-xcframework.sh
# (lives under core/third_party/whisper.cpp/build-* which is already
# ignored via core/third_party/, but keep the explicit globs for clarity.)
core/third_party/whisper.cpp/build-*/

# Archives, IPAs
*.xcarchive/
*.ipa
*.app.dSYM.zip

# CocoaPods (not used today, but pre-emptively ignored)
Pods/
Podfile.lock

# Carthage (not used)
Carthage/Build/

# fastlane (when added)
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

# ─── Whisper models (downloaded at runtime, never committed) ──────────────
*.bin
ggml-*.mlmodelc/
ggml-*.bin.part

# ─── Secrets — must never be committed ────────────────────────────────────
.env
.env.*
!.env.example
*.p8
*.p12
*.cer
*.mobileprovision
*.keystore
*.jks
android/app/upload-keystore.jks
ios/AsItSounds/GoogleService-Info.plist
android/app/google-services.json

# Apple App Store Connect API keys
AuthKey_*.p8

# ─── CI scratch ───────────────────────────────────────────────────────────
.cache/
node_modules/

# ─── Asset generator outputs (regenerated by assets/generate-icons.sh) ────
# Keep res/mipmap-*/*.png + AppIcon-1024.png committed — they're product
# artifacts and stable. If you'd rather regen on every build, uncomment:
# android/app/src/main/res/mipmap-*/ic_launcher*.png
# ios/AsItSounds/Resources/Assets.xcassets/AppIcon.appiconset/Icon-1024.png

# ─── Misc ─────────────────────────────────────────────────────────────────
# CMake user files
CMakeUserPresets.json

# Generated SBOMs (regenerated in CI)
bom.json
bom.xml
sbom.spdx.json
